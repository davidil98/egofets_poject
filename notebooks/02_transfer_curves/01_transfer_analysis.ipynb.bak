       "1  010626_batch1_mta1_03 -0.400221 -0.063412      -0.38      -0.15  0.998472   \n",
       "2  010626_batch2_mta1_00 -0.400207 -0.035869      -0.38      -0.15  0.999142   \n",
       "3  010626_batch2_mta1_02 -0.400066 -0.055758      -0.38      -0.15  0.998531   \n",
       "4  010626_batch3_mta1_00 -0.400090 -0.072461      -0.38      -0.15  0.996893   \n",
       "5  010626_batch3_mta1_03 -0.400136 -0.107325      -0.40      -0.15  0.993265   \n",
