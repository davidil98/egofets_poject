   "source": [
    "# === Loop de extraccion de V_th con ventana definida por rangos manuales ===\n",
    "# Definir los rangos de v_min (izquierda) y v_max (derecha) de la ventana\n",
    "# Mirando los plots anteriores, decides el rectangulo donde buscar\n",
    "\n",
    "v_min_range = (-0.40, -0.38)  # (min, max) del extremo izquierdo\n",
    "v_max_range = (-0.15, -0.05)  # (min, max) del extremo derecho\n",
    "STEP = 0.01                   # V, paso de la busqueda\n",
    "MIN_POINTS = 5                 # minimo de puntos para aceptar el fit\n",
    "\n",
    "v_th_results = []\n",
    "\n",
    "for measurement_name in measurement_list_names:\n",
    "    try:\n",
    "        # 1) Curva con |V_DS| mas alto\n",
    "        curves = read_all_curves(hdf5_path, measurement_name)\n",
    "        i_max = max(range(len(curves)), key=lambda i: abs(curves[i]['v_ds'][0]))\n",
    "        curve = curves[i_max]\n",
    "\n",
    "        # 2) Forward sweep\n",
    "        v_gs_fwd, i_ds_fwd = read_curve(\n",
    "            hdf5_path, measurement_name, curve['curve_name'], fwd_only=True\n",
    "        )\n",
    "        sqrt_ids = np.sqrt(np.abs(i_ds_fwd))\n",
    "\n",
    "        # 3) Buscar 2D en el rectangulo (v_min_range, v_max_range)\n",
    "        best_r2 = -np.inf\n",
    "        best_params = None\n",
    "\n",
    "        for v_min in np.arange(v_min_range[0], v_min_range[1], STEP):\n",
    "            for v_max in np.arange(v_max_range[0], v_max_range[1], STEP):\n",
    "                if v_max <= v_min:  # ventana invalida\n",
    "                    continue\n",
    "                mask = (v_gs_fwd >= v_min) & (v_gs_fwd <= v_max)\n",
    "                if mask.sum() < MIN_POINTS:\n",
    "                    continue\n",
    "\n",
    "                slope, intercept, r_value, _, _ = linregress(v_gs_fwd[mask], sqrt_ids[mask])\n",
    "                r2 = r_value**2\n",
    "\n",
    "                if r2 > best_r2:\n",
    "                    best_r2 = r2\n",
    "                    best_params = (v_min, v_max, slope, intercept, mask.sum())\n",
    "\n",
    "        if best_params is None:\n",
    "            print(f\"{measurement_name}: ninguna ventana valida en el rectangulo\")\n",
    "            continue\n",
    "\n",
    "        v_min, v_max, slope, intercept, n_pts = best_params\n",
    "        v_th = -intercept / slope\n",
    "\n",
    "        v_th_results.append({\n",
    "            'measurement': measurement_name,\n",
    "            'V_DS (V)': curve['v_ds'][0],\n",
    "            'V_th (V)': v_th,\n",
    "            'v_min (V)': v_min,\n",
    "            'v_max (V)': v_max,\n",
    "            'R\u00b2': best_r2,\n",
    "            'n_points': n_pts,\n",
    "        })\n",
    "    except Exception as e:\n",
    "        print(f\"{measurement_name}: {e}\")\n",
    "        continue\n",
    "\n",
    "df_vth = pd.DataFrame(v_th_results)\n",
    "display(df_vth)\n",
    "\n",
    "# Guardar a CSV\n",
    "import os\n",
    "os.makedirs(PROJECT_ROOT / 'output', exist_ok=True)\n",
    "csv_path = PROJECT_ROOT / 'output' / 'vth_all_transfers.csv'\n",
    "df_vth.to_csv(csv_path, index=False)\n",
    "print(f\"\\nGuardado en {csv_path}\")\n"
   ]
  },
